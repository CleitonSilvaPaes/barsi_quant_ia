# =============================================================================
# BARSI QUANT IA — TEMPLATE de variáveis de ambiente
# =============================================================================
# ⚠️ ESTE ARQUIVO É UM TEMPLATE PÚBLICO. NUNCA COLOQUE DADOS REAIS AQUI.
#
# O arquivo `.env` (com valores reais) é o único que deve conter dados sensíveis
# e está protegido pelo .gitignore. Copie este template para `.env` e preencha:
#
# cp .env.example .env && chmod 600 .env
#
# Se você commitou dados reais por engano, siga o procedimento em SECURITY.md
# (seção "Vazamento de credenciais") para purgar o histórico do Git.
# =============================================================================

# Ambiente e Runtime
BARSI_ENV=production
BARSI_LOG_LEVEL=INFO
BARSI_API_PORT=8000
BARSI_API_HOST=0.0.0.0

# Segurança (GERAR VALORES ALEATÓRIOS NO .env LOCAL)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
BARSI_API_BEARER_TOKEN=
BARSI_SECRET_KEY=

# Credenciais do administrador inicial
# Deixe em branco para exigir criação manual via `barsi user-add`
BARSI_INITIAL_ADMIN_USER=
BARSI_INITIAL_ADMIN_PASS=

# Whitelist de titulares (nomes que o parser OFX reconhece como "eu")
# Formato: nomes em MAIÚSCULAS, separados por vírgula
# Exemplo genérico: BARSI_TITULAR_NOMES=NOME COMPLETO DO TITULAR
BARSI_TITULAR_NOMES=

# Palavras-chave de familiares para transferências recorrentes
# Exemplo genérico: BARSI_FAMILIAR_KEYWORDS=NOME PARENTE 1,NOME PARENTE 2
BARSI_FAMILIAR_KEYWORDS=

# Limites de Hardware (TV Box)
BARSI_MAX_CONCURRENCY=3
BARSI_CACHE_DIR=./cache

# Conexão TV Box via SSH (obrigatório preencher no .env para `barsi sync-tvbox`)
BARSI_TVBOX_IP=
BARSI_TVBOX_USER=
BARSI_TVBOX_PASS=

# Diretório base da app na TV Box (varia por instalação)
# Exemplo: /opt/barsi_quant_ia ou /home/SEU_USUARIO/barsi_quant_ia
BARSI_TVBOX_HOME=

# Provedores de Dados de Mercado: yfinance | brapi | cached
BARSI_MARKET_PROVIDER=yfinance
BARSI_BRAPI_TOKEN=

# Provedores de Notícias: rss | stub
BARSI_NEWS_PROVIDER=rss

# Provedores de IA: rule_engine | ollama_remote | openai_compatible
BARSI_AI_PROVIDER=rule_engine
BARSI_OLLAMA_URL=http://127.0.0.1:11434
BARSI_OLLAMA_MODEL=gemma2:2b
BARSI_OPENAI_API_KEY=
BARSI_OPENAI_BASE_URL=

# Google Sheets
BARSI_SHEETS_PROVIDER=gspread
BARSI_SHEETS_SPREADSHEET_ID=
BARSI_SHEETS_CREDENTIALS_JSON=./credentials.json

# Cloudflare R2 (Backup / Histórico Offsite)
BARSI_R2_ENABLED=false
BARSI_R2_ACCOUNT_ID=
BARSI_R2_ACCESS_KEY_ID=
BARSI_R2_SECRET_ACCESS_KEY=
BARSI_R2_BUCKET_NAME=barsi-history

# Alertas Proativos (Telegram Bot)
# Crie um bot em @BotFather no Telegram e obtenha seu Chat ID em @userinfobot
BARSI_TELEGRAM_ALERTS_ENABLED=false
BARSI_TELEGRAM_BOT_TOKEN=
BARSI_TELEGRAM_CHAT_ID=
